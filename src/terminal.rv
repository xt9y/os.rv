# Framebuffer terminal. All text state, control sequences, scrolling, cursor
# and presentation live here, not in the Zig kernel.
import "./font"

pub const state = {
    active = :false,
    cols = 80,
    rows = 25,
    x = 0,
    y = 0,
    escape = 0,
    lines = {}
}

const FG = 14477295
const BG = 857376
const CELL_W = 12
const CELL_H = 20

fn draw(row, col, ch) do
    const px = col * CELL_W
    const py = row * CELL_H
    fb_rect(px, py, CELL_W, CELL_H, BG)
    fb_glyph(px + 1, py + 2, font.glyph(ch), FG, BG)
end

fn reset() do
    state.x = 0
    state.y = 0
    state.lines = {}
    for i in 0..state.rows do
        state.lines:push("")
    end
    fb_clear(BG)
end

pub fn init() do
    if fb_width() == 0 or fb_height() == 0 return :nil
    if fb_width() < 960 state.cols = 60
    if fb_width() < 740 state.cols = 40
    if fb_height() >= 650 state.rows = 30
    if fb_height() < 500 state.rows = 20
    state.active = :true
    reset()
end

fn repaint() do
    fb_clear(BG)
    for row in 0..state.rows do
        const line = state.lines[row]
        for col in 0..(line:len()) do
            draw(row, col, line[col..(col + 1)])
        end
    end
end

fn newline() do
    state.x = 0
    state.y = state.y + 1
    if state.y >= state.rows do
        state.lines:remove(0)
        state.lines:push("")
        state.y = state.rows - 1
        repaint()
    end
end

fn character(ch) do
    if state.x >= state.cols newline()
    const line = state.lines[state.y]
    if state.x >= line:len() do
        state.lines[state.y] = line ~ ch
    else
        state.lines[state.y] = line[0..state.x] ~ ch ~ line[(state.x + 1)..]
    end
    draw(state.y, state.x, ch)
    state.x = state.x + 1
end

fn cursor(color) do
    fb_rect(state.x * CELL_W + 1, state.y * CELL_H + 17, 10, 2, color)
end

fn process(ch) do
    if state.escape != 0 do
        const mode = state.escape
        state.escape = 0
        match mode
            | 1 => do
                if ch == "[" state.escape = 2
            end
            | 2 => do
                if ch == "2" state.escape = 3
                if ch == "H" do
                    state.x = 0
                    state.y = 0
                end
            end
            | 3 => do
                if ch == "J" reset()
            end
            | _ => :nil
        end
        return :nil
    end

    match ch
        | "\x1b" => do state.escape = 1 end
        | "\n" => do newline() end
        | "\r" => do state.x = 0 end
        | "\b" => do if state.x > 0 state.x = state.x - 1 end
        | _ => do character(ch) end
    end
end

pub fn write(text) do
    if state.active == :false return :nil
    cursor(BG)
    for i in 0..(text:len()) do
        process(text[i..(i + 1)])
    end
    cursor(FG)
end
