# All shell cmds

import "./fs"
import "./window"

pub const clear_trm_value = "\x1b[2J\x1b[H"

pub fn process(cmd) do
    match cmd
        | echo when echo:starts_with?("echo") 
            => do match echo 
                | text when text:len() >= 5 => serial_puts(text[5..] ~ "\n")
                | _ => serial_puts("\n")
            end

        | help when help:starts_with?("help")
            => do match help
                | _ => serial_puts("help: echo clear uptime disk fb ps touch ls rm window\n")
               end

        | clear when clear:starts_with?("clear") 
            => do match clear
                | _ => serial_puts(clear_trm_value)
               end

        | uptime when uptime:starts_with?("uptime") 
            => do match uptime
                | _ => print("in ms: ", time_ms())
               end

        | disk when disk:starts_with?("disk") 
            => do match disk
                | _ => print("disk_sectors: ", disk_sectors())
               end

        | fb when fb:starts_with?("fb")
            => do match fb
                | text when text[3..] == "width" => print("fb_width:", fb_width()) 
                | text when text[3..] == "height" => print("fb_height:", fb_height())
                | _ => print("fb_width", fb_width(), "fb_height", fb_height())
               end

        | ps when ps:starts_with?("ps")
            => do match ps
                | _ => print("proc_count: ", proc_count())
               end

        | touch when touch:starts_with?("touch")
            => do match touch
                | text when text:len() >= 5 => fs.create(fs.fs.current_inode, text[6..], fs.TYPE.FILE)
                | _ => print("no argument given")
               end

        | ls when ls:starts_with?("ls")
            => do match ls
                | _ => fs.list_children(fs.fs.current_inode)
               end

        | rm when rm:starts_with?("rm")
            => do match rm
                | text when text:len() >= 3 => fs.remove(fs.fs.current_inode, text[3..])
                | _ => print("")
               end

        | gui when gui:starts_with?("window")
            => do window.demo()
               end

        | "" => :nil
        | _ => serial_puts("unknown command\n")

end

