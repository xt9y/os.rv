# In-memory virtual filesystem (a public Revo module)

pub const FS_TYPE = {
    FILE = :file,
    FOLDER = :folder,
    LINK = :link
}

pub const fs = {
    next_inode = 4,
    root_inode = 1,
    current_inode = 1,
    nodes = {
        {
            inode = 1,
            type = FS_TYPE.FOLDER,
            size = 0,
            children = {
                { name = "bin", inode = 2 },
                { name = "usr.txt", inode = 3 }
            }
        },
        {
            inode = 2,
            type = FS_TYPE.FOLDER,
            size = 0,
            children = {}
        },
        {
            inode = 3,
            type = FS_TYPE.FILE,
            content = "revo is cool",
            size = "revo is cool":len()
        }
    }
}

fn find_inode(id) do
    for i in 0..fs.nodes:len()
        if fs.nodes[i].inode == id return fs.nodes[i]
    return :nil
end

fn check_parent_for_name(parent, name) do
    for i in 0..parent.children:len()
        if parent.children[i].name == name return :true
    return :false
end

pub fn list_children(parent_inode) do
    const parent = find_inode(parent_inode)
    if parent == :nil return 0
    if parent.type != FS_TYPE.FOLDER return 0

    for i in 0..parent.children:len()
        print(parent.children[i].name)
    return :nil
end

pub fn create(parent_inode, name, kind) do
    const parent = find_inode(parent_inode)
    if parent == :nil return 0
    if parent.type != FS_TYPE.FOLDER return 0
    if name == "" or name:contains?("/") or name == "." or name == ".." return 0
    if kind != FS_TYPE.FILE and kind != FS_TYPE.FOLDER and kind != FS_TYPE.LINK return 0
    if check_parent_for_name(parent, name) return 0

    const id = fs.next_inode
    const new_node = {
        inode = id,
        type = kind,
        content = "",
        size = 0,
        children = {},
        target = ""
    }
    fs.nodes:push(new_node)
    parent.children:push({ name = name, inode = id })
    fs.next_inode = id + 1
    return id
end
