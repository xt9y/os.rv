# In-memory virtual filesystem

pub const TYPE = {
    FILE = :file,
    FOLDER = :folder,
    LINK = :link
}

pub const fs = {
    next_inode = 4,
    root_inode = 1,
    current_inode = 1,

    nodes = {
        {   # --> " / "
            inode = 1,
            type = TYPE.FOLDER,
            size = 0,
            children = {
                { name = "bin", inode = 2},
                { name = "usr", inode = 3}
            }
        },

        {   # --> " / bin/ " 
            inode = 2,
            type = TYPE.FOLDER,
            size = 0,
            children = {}
        },

        {   # --> " / usr.txt"
            inode = 3,
            type = TYPE.FILE,
            content = "revo is cool",
            size = "revo is cool":len(),
        },
    },
}


fn find_inode(id) do
    for i in 0..fs.nodes:len()
        if fs.nodes[i].inode == id return fs.nodes[i]
    return :nil
end

fn find_child(parent, name) do
    for i in 0..parent.children:len() do
        const child = parent.children[i]
        if child.name == name return { index = i, inode = child.inode }
    end
    return :nil
end

fn find_node_index(inode) do
    for i in 0..fs.nodes:len()
        if fs.nodes[i].inode == inode return i
    return :nil
end


pub fn list_children(parent_inode) do
    const parent = find_inode(parent_inode)

    if parent == :nil return 0
    if parent.type != :folder return 0

    for i in 0..parent.children:len()
        print(parent.children[i].name)

    return :nil
end

pub fn remove(parent_inode, name) do
    const parent = find_inode(parent_inode)
    if parent == :nil return :false
    if parent.type != :folder return :false

    const child = find_child(parent, name)
    if child == :nil return :nil

    const index = find_node_index(child.inode)
    if index == :nil return :nil

    const node = fs.nodes[index]
    if node.type == :folder and node.children:len() > 0
        return :false

    parent.children:remove(child.index)
    fs.nodes:remove(index)
    return :true
end

pub fn create(parent_inode, name, kind) do
    const parent = find_inode(parent_inode)
    if parent == :nil return :false
    if parent.type != :folder return :false
    if name == "" or name:contains?("/") return :false
    if find_child(parent, name) != :nil return :false

    const new_node = {
        inode = fs.next_inode+1,
        type = kind,
        content = "",
        size = 0,
        children = {},
        target = ""
    }
   
    fs.next_inode = new_node.inode
    fs.nodes:push(new_node)
    
    parent.children:push({
        name = name,
        inode = new_node.inode
    })
    
    return new_node.inode
end


