# 5x7 monospaced glyphs defined in Revo, not in the kernel.
# Seven hexadecimal row masks per glyph, leftmost pixel is bit 4.
pub fn glyph(ch) do
    match ch
        | " " => "00000000000000"
        | "!" => "04040404040004"
        | "\"" => "0a0a0a00000000"
        | "#" => "0a1f0a0a1f0a00"
        | "$" => "040f140e051e04"
        | "%" => "191a0408160600"
        | "&" => "0c12140815120d"
        | "'" => "04040800000000"
        | "(" => "02040808080402"
        | ")" => "08040202020408"
        | "*" => "0004150e150400"
        | "+" => "0004041f040400"
        | "," => "00000000060408"
        | "-" => "0000001f000000"
        | "." => "00000000000c0c"
        | "/" => "01010204081010"
        | "0" => "0e11131519110e"
        | "00000" => "000000000000"
        | "1" => "040c040404040e"
        | "2" => "0e11010204081f"
        | "3" => "1e01010e01011e"
        | "4" => "02060a121f0202"
        | "5" => "1f10101e01011e"
        | "6" => "0e10101e11110e"
        | "7" => "1f010204080808"
        | "8" => "0e11110e11110e"
        | "9" => "0e11110f01010e"
        | ":" => "000c0c000c0c00"
        | ";" => "000c0c000c0408"
        | "<" => "02040810080402"
        | "=" => "001f001f000000"
        | ">" => "08040201020408"
        | "?" => "0e110102040004"
        | "@" => "0e11171517100e"
        | "A" => "0e11111f111111"
        | "B" => "1e11111e11111e"
        | "C" => "0f10101010100f"
        | "D" => "1e11111111111e"
        | "E" => "1f10101e10101f"
        | "F" => "1f10101e101010"
        | "G" => "0f10101711110f"
        | "H" => "1111111f111111"
        | "I" => "0e04040404040e"
        | "J" => "0702020212120c"
        | "K" => "11121418141211"
        | "L" => "1010101010101f"
        | "M" => "111b1515111111"
        | "N" => "11191513111111"
        | "O" => "0e11111111110e"
        | "P" => "1e11111e101010"
        | "Q" => "0e11111115120d"
        | "R" => "1e11111e141211"
        | "S" => "0f10100e01011e"
        | "T" => "1f040404040404"
        | "U" => "1111111111110e"
        | "V" => "11111111110a04"
        | "W" => "1111111515150a"
        | "X" => "11110a040a1111"
        | "Y" => "11110a04040404"
        | "Z" => "1f01020408101f"
        | "[" => "0e08080808080e"
        | "\\" => "10100804020101"
        | "]" => "0e02020202020e"
        | "^" => "040a1100000000"
        | "_" => "0000000000001f"
        | "`" => "08040000000000"
        | "a" => "0e11111f111111"
        | "b" => "1e11111e11111e"
        | "c" => "0f10101010100f"
        | "d" => "1e11111111111e"
        | "e" => "1f10101e10101f"
        | "f" => "1f10101e101010"
        | "g" => "0f10101711110f"
        | "h" => "1111111f111111"
        | "i" => "0e04040404040e"
        | "j" => "0702020212120c"
        | "k" => "11121418141211"
        | "l" => "1010101010101f"
        | "m" => "111b1515111111"
        | "n" => "11191513111111"
        | "o" => "0e11111111110e"
        | "p" => "1e11111e101010"
        | "q" => "0e11111115120d"
        | "r" => "1e11111e141211"
        | "s" => "0f10100e01011e"
        | "t" => "1f040404040404"
        | "u" => "1111111111110e"
        | "v" => "11111111110a04"
        | "w" => "1111111515150a"
        | "x" => "11110a040a1111"
        | "y" => "11110a04040404"
        | "z" => "1f01020408101f"
        | "{" => "02040408040402"
        | "|" => "04040404040404"
        | "}" => "08040402040408"
        | "~" => "00000916000000"
        | _ => "0e110102040004"
    end
end
