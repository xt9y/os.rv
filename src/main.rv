# The host terminal sends UTF-8 bytes over QEMU COM1.
# OS behavior is entirely in Revo; native hardware access stays in kernel.zig.

# constants
global shell = { line = "" }
global disk_test = { sector = "" }

import "./cmd"
import "./terminal"

terminal.init()
global terminal_output = fn(text) do terminal.write(text) end

global on_input = fn(ch) do

    if ch == "\n" do
        serial_puts("\n")
        cmd.process(shell.line)
        shell.line = ""
        serial_puts("> ")
        return :nil
    end

    if ch == "\b" do
        if shell.line:len() > 0 do
            shell.line = shell.line[0..(shell.line:len() - 1)]
            serial_puts("\b \b")
        end
        return :nil
    end

    shell.line = shell.line ~ ch
    serial_puts(ch)

end

serial_puts(cmd.clear_trm_value)
serial_puts("REVO operating system => xt9y/kernel.zig contains the modular language independent kernel.\n") 
serial_puts("Everything else is done inside xt9y/os.rv\n\n")

serial_puts("Welcome to the OS :)\n")
serial_puts("WIP enjoy, press enter to enter.\n")

