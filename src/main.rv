# The host terminal sends UTF-8 bytes over QEMU COM1.
# OS behavior is entirely in Revo; native hardware access stays in kernel.zig.

global shell = { line = "" }
global disk_test = { sector = "" }

global on_input = fn(ch) do
    if ch == "\n" do
        serial_puts("\n")
        const cmd = shell.line

        match cmd
            | value when value:starts_with?("echo") => do
                match value
                    | text when text:len() >= 5 => serial_puts(text[5..] ~ "\n")
                    | _ => serial_puts("\n")
            end
            | "help" => serial_puts("help: echo clear uptime disk fb ps\n")
            | "clear" => serial_puts("\x1b[2J\x1b[H")
            | "uptime" => print("in ms: ", time_ms())
            | "disk" => print("disk_sectors: ", disk_sectors())
            | "fb" => print("fb_width:", fb_width(), "fb_height:", fb_height())
            | "ps" => print("proc_count: ", proc_count())
            | "" => :nil
            | _ => serial_puts("unknown command\n")
        
        shell.line = ""
        serial_puts("> ")
        return :nil
    end

    if ch == "\b" do
        if shell.line:len() > 0 do
            shell.line = shell.line[0..(shell.line:len() - 1)]
            serial_puts("\b \b")
        end
        return :nil
    end

    shell.line = shell.line ~ ch
    serial_puts(ch)
end

serial_puts("os.rv\n")
serial_puts("kernel.zig: disk, timer, framebuffer, ring3 primitives\n\n> ")
